# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Customer origin for metadata. No trailing slash. On Vercel production,
# VERCEL_PROJECT_PRODUCTION_URL is used when this is unset.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Optional. Server errors are sent to Sentry only when this is set.
# SENTRY_DSN=https://public@o0.ingest.sentry.io/0

# Direct Postgres connection for migrations, the catalog CLI, and the dev shell.
# Export DATABASE_URL yourself. Do not commit it, and do not set it on the public app.
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres
